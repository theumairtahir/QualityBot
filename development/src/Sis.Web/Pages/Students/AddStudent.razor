@page "/students/new"
@using Sis.Contracts.Students
@inject StudentsClient Students
@inject IToastService Toasts
@inject NavigationManager Navigation

<PageTitle>Add student · SIS</PageTitle>

<PageHeading Title="Add student" Description="Enter the student's basic details." />

<StudentForm OnSave="@(request => Students.CreateAsync(request))" OnSaved="Saved" />

@code {
    private void Saved(StudentResponse student)
    {
        Toasts.ShowSuccess("Student added", $"{student.FirstName} {student.LastName} is now on record.");
        Navigation.NavigateTo("/students");
    }
}
