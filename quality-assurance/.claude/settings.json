{
  "extraKnownMarketplaces": {
    "quality-assurance": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  },
  "enabledPlugins": {
    "test-strategy@quality-assurance": true,
    "functional-testing@quality-assurance": true,
    "automation@quality-assurance": true,
    "performance-testing@quality-assurance": true,
    "api-testing@quality-assurance": true,
    "quality-metrics@quality-assurance": true,
    "accessibility-testing@quality-assurance": true,
    "qa-toolkit@quality-assurance": true
  },
  "enableAllProjectMcpServers": true,
  "permissions": {
    "additionalDirectories": ["../development"],
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Skill",
      "TodoWrite",
      "mcp__playwright",
      "Bash(./scripts/db.sh:*)",
      "Bash(./scripts/publish-screenshots.sh:*)",
      "Bash(./scripts/post-comment.sh:*)",
      "Bash(./scripts/post-review.sh:*)",
      "Bash(./scripts/commit-tests.sh:*)",
      "Bash(npm run:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx tsc:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh issue view:*)",
      "Bash(gh api:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(jq:*)",
      "Bash(curl:*)"
    ],
    "deny": [
      "Bash(docker:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git rebase:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Edit(../development/**)",
      "Write(../development/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./.mcp.json)",
      "Write(./.mcp.json)",
      "Edit(./scripts/**)",
      "Write(./scripts/**)",
      "Read(**/.env*)"
    ]
  }
}
